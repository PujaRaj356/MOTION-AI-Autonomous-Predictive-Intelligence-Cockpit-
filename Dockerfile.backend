FROM python:3.11-slim

WORKDIR /app

# Only install curl for Docker healthcheck (removes 7-minute build-essential compile overhead)
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Install PyTorch CPU-only first from PyTorch official CPU wheel index
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

# Install remaining dependencies without torch to prevent PyPI from downloading 1.5GB of CUDA/NVIDIA packages
COPY backend/requirements.docker.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY backend/ ./backend/
COPY ml/ ./ml/
COPY data/ ./data/
COPY scripts/ ./scripts/

ENV PORT=8000
ENV OMP_NUM_THREADS=1
ENV MKL_NUM_THREADS=1
ENV WEB_CONCURRENCY=1

EXPOSE 8000

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
